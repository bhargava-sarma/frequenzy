# Copy this file to `.env` and fill in your real values.
#   cp .env.example .env
#
# `.env` is gitignored. Never put real credentials or server IPs in this
# example file — it IS committed.
#
# The EXPO_PUBLIC_ prefix is required for Expo to expose a variable to the app
# bundle. Note what "public" means: these values are inlined into the compiled
# JS, so anyone with the APK can read them. That is acceptable for Phase 0 dev
# scaffolding on your own device, and Phase 1 replaces it — the app will read
# credentials from expo-secure-store entered via the setup screen, and will
# stop reading env entirely. The Node scripts in scripts/ keep using these.

# Your Navidrome server, reachable at up to two addresses.
# At least one is required. Include the scheme and port.
# The client always tries LOCAL first, then falls back to REMOTE.
EXPO_PUBLIC_NAVIDROME_LOCAL_URL=http://192.168.1.10:4533
EXPO_PUBLIC_NAVIDROME_REMOTE_URL=http://100.64.0.1:4533

# Navidrome login. Same credentials work at both addresses (same server).
EXPO_PUBLIC_NAVIDROME_USERNAME=
EXPO_PUBLIC_NAVIDROME_PASSWORD=
