# Copy this file to `.env` and fill in your real values.
#   cp .env.example .env
#
# `.env` is gitignored. Never put real credentials or server IPs in this
# example file — it IS committed.
#
# These values are read ONLY by the dev scripts in `scripts/`, which run on
# your laptop under Node. They are deliberately NOT prefixed EXPO_PUBLIC_,
# because that prefix inlines a value into the app bundle where anyone with
# the APK could read it. The app gets its credentials from the setup screen
# instead and stores them in the device keystore via expo-secure-store.

# Your Navidrome server, reachable at up to two addresses.
# At least one is required. Include the scheme and port.
# The client tries LOCAL first and falls back to REMOTE.
NAVIDROME_LOCAL_URL=http://192.168.1.10:4533
NAVIDROME_REMOTE_URL=http://100.64.0.1:4533

# Navidrome login. Same credentials work at both addresses (same server).
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=
