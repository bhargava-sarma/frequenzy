# Copy this file to `.env` and fill in your real values.
#   cp .env.example .env
#
# `.env` is gitignored. Never put real credentials or server IPs in this
# example file — it IS committed.
#
# These values are only used by the local dev scripts in `scripts/` (run on
# your laptop via Node). The app itself never reads these; on-device the
# same config comes from the setup screen and is stored in expo-secure-store.

# Your Navidrome server, reachable at up to two addresses.
# At least one of these is required. Include the scheme and port.
# The client always tries LOCAL first, then falls back to REMOTE.
NAVIDROME_LOCAL_URL=http://192.168.1.10:4533
NAVIDROME_REMOTE_URL=http://100.64.0.1:4533

# Navidrome login. Same credentials work at both addresses (same server).
NAVIDROME_USERNAME=
NAVIDROME_PASSWORD=
